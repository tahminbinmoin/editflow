{
  "name": "editflow",
  "version": "0.1.0",
  "private": true,
  "description": "Editflow — story-first video editor MVP for short-form creators",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/copy-ffmpeg.mjs && vite",
    "build": "node scripts/copy-ffmpeg.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test test/unit.test.js test/api.test.js test/render.test.js",
    "sample": "node scripts/make-sample.mjs",
    "mock:ai": "node test/mock-ai.js",
    "mock:supabase": "node test/mock-supabase.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^6.0.3"
  }
}
